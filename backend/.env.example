# ==========================================
# AETHEROPS BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Google Gemini API Key (Get free key from: https://aistudio.google.com/)
# If empty, AetherOps will use its built-in deterministic fallback generator.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key
OPENAI_API_KEY=

# Execution Timeout for Subprocess Sandbox (in seconds)
SANDBOX_TIMEOUT_SECONDS=15
